{
  "MongoDbSettings": {
    "ConnectionString": "mongodb://localhost:27017",
    "DatabaseName": "vacation_manager_db"
  },
  "JwtOptions": {
    "Issuer": "VacationManager.Api",
    "Audience": "VacationManager.Client",
    "Secret": "CHANGE_THIS_TO_A_LONG_RANDOM_SECRET_AT_LEAST_32_CHARS",
    "ExpiresInMinutes": 120
  },
  "FileStorage": {
    "SickNotesPath": "Uploads/sick-notes"
  },
  "Seed": {
    "DefaultCeoUsername": "ceo",
    "DefaultCeoPassword": "ChangeMe123!",
    "EnableDemoData": false
  },
  "Logging": {
    "LogLevel": {
      "Default": "Information",
      "Microsoft.AspNetCore": "Warning"
    }
  },
  "AllowedHosts": "*",
  "Cors": {
    "AllowedOrigins": [
      "http://localhost:3000",
      "http://localhost:5173",
      "http://127.0.0.1:3000",
      "http://127.0.0.1:5173"
    ]
  }
}
